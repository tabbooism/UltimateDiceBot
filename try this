        // Tab 4: Discord
        JPanel discPanel = new JPanel(new GridBagLayout());
        gbc = new GridBagConstraints();
        gbc.insets = new Insets(5,5,5,5);
        gbc.anchor = GridBagConstraints.WEST;
        gbc.fill = GridBagConstraints.HORIZONTAL;
        row = 0;
        JCheckBox discEnabled = new JCheckBox("Enable Discord Notifications");
        gbc.gridx = 0; gbc.gridy = row++; gbc.gridwidth = 2;
        discPanel.add(discEnabled, gbc);
        gbc.gridwidth = 1;
        addRow(discPanel, gbc, row++, "Webhook URL:", new JTextField("https://discord.com/api/webhooks/...", 30));
        tabs.addTab("Discord", discPanel);

        // Status bar
        statusLabel = new JLabel(" Ready");
        statusLabel.setBorder(BorderFactory.createEtchedBorder());

        // Start button
        JButton startBtn = new JButton("Start UltimateDiceBot Pro");
        startBtn.addActionListener(e -> {
            try {
                // Gather settings from GUI
                BotConfig cfg = new BotConfig();
                // Simple extraction for brevity – in production we'd fetch each field properly.
                // Here we'll just use a simple approach.
                JTextField minField = (JTextField) ((JPanel)betPanel.getComponent(1)).getComponent(1);
                JTextField maxField = (JTextField) ((JPanel)betPanel.getComponent(3)).getComponent(1);
                JTextField lowField = (JTextField) ((JPanel)betPanel.getComponent(5)).getComponent(1);
                cfg.minBet = Long.parseLong(minField.getText());
                cfg.maxBet = Long.parseLong(maxField.getText());
                cfg.lowFundsThresholdPct = Double.parseDouble(lowField.getText());
                cfg.bankrollSource = bankrollSource.getSelectedIndex() == 0 ? BankrollSource.BANK_AND_INVENTORY : BankrollSource.INVENTORY_ONLY;
                cfg.antiBanEnabled = antiBanCheck.isSelected();
                // Payout table
                for (int r = 0; r < model.getRowCount(); r++) {
                    int sum = Integer.parseInt(model.getValueAt(r, 0).toString());
                    double mult = Double.parseDouble(model.getValueAt(r, 1).toString());
                    cfg.payoutTable.put(sum, mult);
                }
                cfg.feeEnabled = feeCheck.isSelected();
                cfg.feeRate = Double.parseDouble(feeField.getText());
                cfg.payoutCurrency = PayoutCurrency.values()[currencyCombo.getSelectedIndex()];
                cfg.antiLureEnabled = antiLure.isSelected();
                cfg.tradeSpamLimit = Integer.parseInt(((JTextField)((JPanel)secPanel.getComponent(3)).getComponent(1)).getText());
                cfg.blacklistDurationMs = Long.parseLong(((JTextField)((JPanel)secPanel.getComponent(5)).getComponent(1)).getText()) * 60000;
                cfg.discordEnabled = discEnabled.isSelected();
                cfg.discordWebhookUrl = ((JTextField)((JPanel)discPanel.getComponent(3)).getComponent(1)).getText().trim();

                // Validate
                if (cfg.minBet <= 0 || cfg.maxBet < cfg.minBet) throw new Exception("Invalid bet limits");
                if (cfg.discordEnabled && !cfg.discordWebhookUrl.startsWith("https://discord.com/api/webhooks/"))
                    throw new Exception("Invalid Discord webhook");

                config = cfg;
                frame.dispose();
                currentState = BotState.CONFIG_CHECK;
                log("Configuration saved. Starting bot.");
            } catch (Exception ex) {
                JOptionPane.showMessageDialog(frame, "Error: " + ex.getMessage(), "Configuration Error", JOptionPane.ERROR_MESSAGE);
            }
        });

        JPanel bottom = new JPanel(new BorderLayout());
        bottom.add(startBtn, BorderLayout.CENTER);
        bottom.add(statusLabel, BorderLayout.SOUTH);

        frame.add(tabs, BorderLayout.CENTER);
        frame.add(bottom, BorderLayout.SOUTH);
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }

    private void addRow(JPanel p, GridBagConstraints c, int row, String label, JComponent field) {
        c.gridx = 0; c.gridy = row; c.weightx = 0;
        p.add(new JLabel(label), c);
        c.gridx = 1; c.weightx = 1;
        p.add(field, c);
    }
}
