    private int handleBet() {
        if (!Trade.isOpen()) {
            currentState = BotState.ERROR_RECOVERY;
            return 500;
        }

        // Wait for items
        Sleep.sleepUntil(() -> Trade.getTheirItems().length > 0, 3000);
        Item[] theirItems = Trade.getTheirItems();
        if (theirItems == null || theirItems.length == 0) {
            log("No items offered; declining.");
            Trade.decline();
            currentState = BotState.WAITING_FOR_TRADE;
            return 500;
        }

        // Anti‑lure: reject non‑currency items
        if (config.antiLureEnabled) {
            for (Item item : theirItems) {
                int id = item.getID();
                if (id != COIN_ID && id != PLATINUM_TOKEN_ID) {
                    log("Non‑currency item (" + item.getName() + ") – declining.");
                    Trade.decline();
                    currentState = BotState.WAITING_FOR_TRADE;
                    return 500;
                }
            }
        }

        // Calculate bet value
        long betCoins = 0;
        for (Item item : theirItems) {
            if (item.getID() == COIN_ID) betCoins += item.getAmount();
            else if (item.getID() == PLATINUM_TOKEN_ID) betCoins += item.getAmount() * PLATINUM_VALUE;
        }
        if (betCoins <= 0) {
            log("Zero‑value bet; declining.");
            Trade.decline();
            currentState = BotState.WAITING_FOR_TRADE;
            return 500;
        }

        // Validate against limits and bankroll
        long dynamicMax = Math.max(1L, (long)(getTotalBankrollCoins() * 0.10));
        long effectiveMax = Math.min(config.maxBet, dynamicMax);
        if (betCoins < config.minBet || betCoins > effectiveMax) {
            log("Bet " + betCoins + " outside limits (" + config.minBet + " – " + effectiveMax + "); declining.");
            Trade.decline();
            currentState = BotState.WAITING_FOR_TRADE;
            return 500;
        }

        currentBetCoins = betCoins;

        // Roll dice
        int die1 = random.nextInt(6) + 1;
        int die2 = random.nextInt(6) + 1;
        int sum = die1 + die2;
        double multiplier = config.payoutTable.getOrDefault(sum, 0.0);
        boolean win = multiplier > 0;
        long rawPayout = (long)(betCoins * multiplier);
        if (config.feeEnabled && config.feeRate > 0) {
            rawPayout -= (long)(rawPayout * config.feeRate / 100.0);
        }
        lastPayoutCoins = win ? rawPayout : 0;

        log(String.format("Roll: %d+%d=%d → %s", die1, die2, sum, win ? "WIN" : "LOSS"));
        discordSend(String.format("%s | `%s` | Bet: %s | Roll: %d+%d=%d | %s",
                win ? ":game_die: **WIN**" : ":game_die: **LOSS**",
                currentTradePlayer,
                formatCoins(betCoins),
                die1, die2, sum,
                win ? "Payout: " + formatCoins(lastPayoutCoins) : ""));

        // Accept trade
        if (!Trade.accept()) {
            log("Failed to accept trade.");
            currentState = BotState.ERROR_RECOVERY;
            return 500;
        }
        Sleep.sleepUntil(() -> Trade.isFirstScreenOpen(), 5000);
        if (!Trade.isFirstScreenOpen()) {
            log("First screen not open.");
            currentState = BotState.ERROR_RECOVERY;
            return 500;
        }

        if (!Trade.confirm()) {
            log("Failed to confirm trade.");
            currentState = BotState.ERROR_RECOVERY;
            return 500;
        }
        Sleep.sleepUntil(() -> !Trade.isOpen(), 5000);

        totalBets++;
        if (win) {
            sessionProfit -= (lastPayoutCoins - currentBetCoins);
            currentState = BotState.PAYING_WINNINGS;
        } else {
            sessionProfit += currentBetCoins;
            currentState = BotState.LOSS_OR_PAYOUT_COMPLETE;
        }
        return 500;
    }

    private int handlePayout() {
        if (getTotalBankrollCoins() < lastPayoutCoins) {
            log("Insufficient funds for payout. Recording debt.");
            recordDebt(currentTradePlayer, lastPayoutCoins);
            currentState = BotState.LOSS_OR_PAYOUT_COMPLETE;
            return 500;
        }

        // Find winner – try getOtherPlayer again, else fallback to nearest player
        Player winner = null;
        try {
            winner = Trade.getOtherPlayer();
        } catch (Exception ignored) {}
        if (winner == null) {
            // Fallback: find player with the stored name
            for (Player p : Players.all()) {
                if (p != null && p.getName().equals(currentTradePlayer)) {
                    winner = p;
                    break;
                }
            }
        }
        if (winner == null) {
            log("Winner not found. Recording debt.");
            recordDebt(currentTradePlayer, lastPayoutCoins);
            currentState = BotState.LOSS_OR_PAYOUT_COMPLETE;
            return 500;
        }

        // Initiate trade
        if (!winner.interact("Trade with")) {
            log("Could not initiate trade with winner. Recording debt.");
            recordDebt(currentTradePlayer, lastPayoutCoins);
            currentState = BotState.LOSS_OR_PAYOUT_COMPLETE;
            return 500;
        }
        Sleep.sleepUntil(() -> Trade.isOpen(), 8000);
        if (!Trade.isOpen()) {
            log("Trade window did not open for payout. Recording debt.");
            recordDebt(currentTradePlayer, lastPayoutCoins);
            currentState = BotState.LOSS_OR_PAYOUT_COMPLETE;
            return 500;
        }

        // Offer coins (simplified; could offer tokens if preferred, but we'll keep simple)
        if (!Trade.offer(COIN_ID, (int)Math.min(lastPayoutCoins, Integer.MAX_VALUE))) {
            log("Failed to offer coins. Recording debt.");
            recordDebt(currentTradePlayer, lastPayoutCoins);
            Trade.decline();
            currentState = BotState.LOSS_OR_PAYOUT_COMPLETE;
            return 500;
        }
        Sleep.sleep(1000);

        if (!Trade.accept()) {
            log("Failed to accept payout trade. Recording debt.");
            recordDebt(currentTradePlayer, lastPayoutCoins);
            Trade.decline();
            currentState = BotState.LOSS_OR_PAYOUT_COMPLETE;
            return 500;
        }
        Sleep.sleepUntil(() -> Trade.isFirstScreenOpen(), 5000);
        if (!Trade.isFirstScreenOpen()) {
            log("First screen not open for payout. Recording debt.");
            recordDebt(currentTradePlayer, lastPayoutCoins);
            currentState = BotState.LOSS_OR_PAYOUT_COMPLETE;
            return 500;
        }

        if (!Trade.confirm()) {
            log("Failed to confirm payout trade. Recording debt.");
            recordDebt(currentTradePlayer, lastPayoutCoins);
            currentState = BotState.LOSS_OR_PAYOUT_COMPLETE;
            return 500;
        }
        Sleep.sleepUntil(() -> !Trade.isOpen(), 5000);

        totalWins++;
        sessionProfit += (currentBetCoins - lastPayoutCoins);
        log("Payout complete: " + formatCoins(lastPayoutCoins));
        currentState = BotState.LOSS_OR_PAYOUT_COMPLETE;
        return 500;
    }

    private int handleLossOrComplete() {
        resetTradeState();
        checkLowFunds();
        currentState = BotState.WAITING_FOR_TRADE;
        return 800;
