    private int handleOutOfFunds() {
        updateStatus("OUT OF FUNDS – retrying in 60 s | Debts: " + debtLog.size());
        if (config.bankrollSource == BankrollSource.BANK_AND_INVENTORY) {
            sleep((int)BANK_RETRY_DELAY_MS);
            if (loadFromBank(config.minBet * 20)) {
                currentState = BotState.WAITING_FOR_TRADE;
            } else {
                log("Bank reload failed. Will retry later.");
                // stay in OUT_OF_FUNDS
            }
        } else {
            log("Inventory‑only mode and out of funds. Stopping.");
            stop();
        }
        return 2000;
    }

    private int handleErrorRecovery() {
        try { if (Trade.isOpen()) Trade.decline(); } catch (Exception ignored) {}
        resetTradeState();
        sleep(1500);
        currentState = BotState.WAITING_FOR_TRADE;
        return 500;
    }

    // ──────────────────────────────────────── Helpers ──────────────────────────────────────
    private long getTotalBankrollCoins() {
        return Inventory.count(COIN_ID) + Inventory.count(PLATINUM_TOKEN_ID) * PLATINUM_VALUE;
    }

    private boolean loadFromBank(long needed) {
        try {
            if (!Bank.isOpen()) {
                if (!Bank.open()) {
                    sleep(2000);
                    Bank.open();
                }
            }
            Sleep.sleepUntil(Bank::isOpen, 6000);
            if (!Bank.isOpen()) return false;
            long bankCoins = Bank.count(COIN_ID);
            if (bankCoins >= needed) {
                Bank.withdraw(COIN_ID, (int)Math.min(bankCoins, needed + config.minBet * 5));
                Bank.close();
                return true;
            }
            Bank.close();
            return false;
        } catch (Exception e) {
            log("Bank load error: " + e.getMessage());
            return false;
        }
    }

    private void checkLowFunds() {
        long bankroll = getTotalBankrollCoins();
        if (bankroll < config.minBet * 10) {
            log("Low funds warning.");
            discordSend(":warning: **Low Funds** | Bankroll: " + formatCoins(bankroll));
            if (config.bankrollSource == BankrollSource.BANK_AND_INVENTORY) {
                loadFromBank(config.minBet * 20);
            }
        }
    }

    private boolean isBlacklisted(String name) {
        Long expiry = blacklist.get(name.toLowerCase());
        if (expiry == null) return false;
        if (System.currentTimeMillis() > expiry) {
            blacklist.remove(name.toLowerCase());
            return false;
        }
        return true;
    }

    private void blacklistPlayer(String name) {
        blacklist.put(name.toLowerCase(), System.currentTimeMillis() + config.blacklistDurationMs);
        log("Blacklisted: " + name + " for " + config.blacklistDurationMs/60000 + " min");
        discordSend(":no_entry: Blacklisted `" + name + "`");
    }

    private void expireBlacklist() {
        long now = System.currentTimeMillis();
        blacklist.entrySet().removeIf(e -> e.getValue() < now);
    }

    private boolean isSpamming(String name) {
        ConcurrentLinkedQueue<Long> q = tradeAttempts.computeIfAbsent(name.toLowerCase(), k -> new ConcurrentLinkedQueue<>());
        long now = System.currentTimeMillis();
        q.removeIf(t -> now - t > 60000);
        return q.size() >= config.tradeSpamLimit;
    }

    private void recordTradeAttempt(String name) {
        tradeAttempts.computeIfAbsent(name.toLowerCase(), k -> new ConcurrentLinkedQueue<>()).add(System.currentTimeMillis());
    }

    private void recordDebt(String player, long coins) {
        String msg = String.format("Debt recorded: %s owes %s", player, formatCoins(coins));
        debtLog.add(msg);
        log(msg);
        sendChat("@" + player + " Insufficient funds for automatic payout. Manual payout will be arranged.");
        discordSend(":ledger: **Debt** | `" + player + "` | " + formatCoins(coins));
    }

    private void resetTradeState() {
        currentTradePlayer = null;
        currentBetCoins = 0;
        lastPayoutCoins = 0;
    }

    private boolean shouldTakeBreak() {
        return System.currentTimeMillis() - lastBreakTime > 30000 && random.nextInt(100) < 2;
    }

    private void runAntiBan() {
        long now = System.currentTimeMillis();
        if (now - lastAntiBanTime < 5000 + random.nextInt(10000)) return;
        lastAntiBanTime = now;
        try {
            switch (random.nextInt(4)) {
                case 0: Camera.rotateTo(random.nextInt(360), 60 + random.nextInt(30)); break;
                case 1:
                    Camera.rotateTo((Camera.getYaw() + random.nextInt(80) - 40 + 360) % 360, Camera.getPitch());
                    break;
                case 2:
                    Tabs.open(Tab.SKILLS);
                    sleep(200 + random.nextInt(400));
                    Tabs.open(Tab.INVENTORY);
                    break;
                case 3: sleep(100 + random.nextInt(300)); break;
            }
        } catch (Exception ignored) {}
    }

    private void sendChat(String message) {
        try {
            getKeyboard().type(message, true);
        } catch (Exception ignored) {}
    }

    private void discordSend(String message) {
        if (!config.discordEnabled || config.discordWebhookUrl == null || config.discordWebhookUrl.isEmpty()) return;
        new Thread(() -> {
            try {
                URL url = new URL(config.discordWebhookUrl);
                HttpURLConnection conn = (HttpURLConnection) url.openConnection();
                conn.setRequestMethod("POST");
                conn.setRequestProperty("Content-Type", "application/json");
                conn.setDoOutput(true);
                conn.setConnectTimeout(5000);
                conn.setReadTimeout(5000);
                String ts = DateTimeFormatter.ofPattern("HH:mm:ss").format(LocalDateTime.now());
                String json = "{\"content\":\"[" + ts + "] " + message.replace("\"", "\\\"") + "\"}";
                try (OutputStream os = conn.getOutputStream()) {
                    os.write(json.getBytes(StandardCharsets.UTF_8));
                }
                int code = conn.getResponseCode();
                if (code != 204 && code != 200) log("Discord HTTP " + code);
                conn.disconnect();
            } catch (Exception e) {
                log("Discord error: " + e.getMessage());
            }
        }).start();
    }

    private void log(String msg) {
        Logger.log("[" + DateTimeFormatter.ofPattern("HH:mm:ss").format(LocalDateTime.now()) + "] " + msg);
    }

    private void updateStatus(String s) {
        if (statusLabel != null) SwingUtilities.invokeLater(() -> statusLabel.setText(" " + s));
    }

    private String formatCoins(long coins) {
        if (coins >= 1_000_000) return String.format("%.2fM", coins / 1_000_000.0);
        if (coins >= 1_000)     return String.format("%.1fK", coins / 1_000.0);
        return String.valueOf(coins);
    }

