## 📦 File 2: `deploy.ps1` (Hardened Auto‑Deploy)

```powershell
#Requires -Version 5.1
# ============================================================
#  UltimateDiceBot Pro — Hardened Deploy Script v3.0
#  Automatically locates the correct client.jar and compiles
# ============================================================
param(
    [string]$JavaHome      = "",
    [string]$DreamBotJar   = "",
    [string]$SourceFile    = "UltimateDiceBot.java",
    [string]$OutputJar     = "UltimateDiceBot.jar",
    [switch]$SkipCopy,
    [switch]$Verbose
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

function Write-Step   { param($m) Write-Host "[STEP] $m" -ForegroundColor Cyan }
function Write-Ok     { param($m) Write-Host "[ OK ] $m" -ForegroundColor Green }
function Write-Warn   { param($m) Write-Host "[WARN] $m" -ForegroundColor Yellow }
function Write-Err    { param($m) Write-Host "[FAIL] $m" -ForegroundColor Red }
function Write-Info   { param($m) Write-Host "[INFO] $m" -ForegroundColor Gray }

Write-Host "`n============================================================" -ForegroundColor Magenta
Write-Host "   UltimateDiceBot Pro — Hardened Deploy v3.0" -ForegroundColor Magenta
Write-Host "============================================================`n" -ForegroundColor Magenta

# ---- 1. Locate Java (javac) ----
Write-Step "Locating Java compiler (javac)..."
$javac = $null
if ($JavaHome -and (Test-Path "$JavaHome\bin\javac.exe")) {
    $javac = "$JavaHome\bin\javac.exe"
    Write-Ok "Using supplied JavaHome: $JavaHome"
} else {
    # Check PATH
    $javac = (Get-Command "javac" -ErrorAction SilentlyContinue).Source
    if (-not $javac) {
        # Scan common JDK directories
        $paths = @(
            "C:\Program Files\Java\jdk-*",
            "C:\Program Files\Eclipse Adoptium\jdk-*",
            "C:\Program Files\Microsoft\jdk-*",
            "$env:LOCALAPPDATA\Programs\Eclipse Adoptium\jdk-*"
        )
        foreach ($p in $paths) {
            $dirs = Get-ChildItem $p -Directory -ErrorAction SilentlyContinue | Sort-Object Name -Descending
            foreach ($d in $dirs) {
                $candidate = Join-Path $d.FullName "bin\javac.exe"
                if (Test-Path $candidate) {
                    $javac = $candidate
                    break
                }
            }
            if ($javac) { break }
        }
    }
}
if (-not $javac) {
    Write-Err "JDK 11+ not found. Please install and add to PATH, or use -JavaHome."
    exit 1
}
Write-Ok "javac: $javac"
$java = Join-Path (Split-Path $javac -Parent) "java.exe"
if (-not (Test-Path $java)) { $java = "java" }
$ver = & $java -version 2>&1 | Select-Object -First 1
Write-Info "Java version: $ver"

# ---- 2. Locate Source File ----
Write-Step "Locating source: $SourceFile"
if (-not (Test-Path $SourceFile)) {
    $alt = Join-Path $PSScriptRoot $SourceFile
    if (Test-Path $alt) { $SourceFile = $alt }
    else {
        Write-Err "Source file not found."
        exit 1
    }
}
Write-Ok "Source: $(Resolve-Path $SourceFile)"

# ---- 3. Locate the REAL DreamBot client.jar ----
Write-Step "Locating DreamBot client.jar..."
$jar = $null

# 3a. User-supplied
if ($DreamBotJar -and (Test-Path $DreamBotJar)) {
    $jar = $DreamBotJar
    Write-Ok "Using supplied jar: $jar"
} else {
    # 3b. Common locations
    $candidates = @(
        "$env:USERPROFILE\.dreambot\BotData\client.jar",
        "$env:USERPROFILE\.dreambot\client.jar",
        "$env:APPDATA\.dreambot\BotData\client.jar",
        "$env:APPDATA\.dreambot\client.jar",
        "C:\Program Files\DreamBot\BotData\client.jar",
        "C:\Program Files (x86)\DreamBot\BotData\client.jar",
        "$env:USERPROFILE\DreamBot\client.jar"
    )
    foreach ($c in $candidates) {
        if (Test-Path $c) { $jar = $c; break }
    }

    # 3c. Search for any jar containing AbstractScript.class
    if (-not $jar) {
        Write-Info "Searching for jars containing AbstractScript.class..."
        $searchPaths = @(
            "$env:USERPROFILE\.dreambot",
            "$env:APPDATA\.dreambot",
            "C:\Program Files\DreamBot",
            "C:\Program Files (x86)\DreamBot"
        )
        foreach ($sp in $searchPaths) {
            if (Test-Path $sp) {
                $found = Get-ChildItem $sp -Recurse -Filter "*.jar" -ErrorAction SilentlyContinue |
                    Where-Object { $_.Length -gt 5MB } |
                    ForEach-Object {
                        $test = & jar tf $_.FullName 2>$null | Select-String "AbstractScript"
                        if ($test) { $_.FullName }
                    } | Select-Object -First 1
                if ($found) { $jar = $found; break }
            }
        }
    }

    # 3d. Interrogate running DreamBot process (most reliable)
    if (-not $jar) {
        Write-Info "Searching for running DreamBot process..."
        $proc = Get-Process -Name java -ErrorAction SilentlyContinue |
            Where-Object { $_.MainWindowTitle -match "DreamBot|OSRS|RuneScape" } |
            Select-Object -First 1
        if ($proc) {
            $cmd = (Get-CimInstance Win32_Process -Filter "ProcessId = $($proc.Id)").CommandLine
            if ($cmd -match "-classpath\s+([^\s]+\.jar)") {
                $candidate = $matches[1]
                if (Test-Path $candidate) {
                    $test = & jar tf $candidate 2>$null | Select-String "AbstractScript"
                    if ($test) { $jar = $candidate; Write-Ok "Found jar from running process: $jar" }
                }
            }
        }
    }

    # 3e. If still not found, prompt user
    if (-not $jar) {
        Write-Warn "Could not auto-detect client.jar. Please enter the full path to the REAL DreamBot client.jar"
        Write-Host "   (It must contain org/dreambot/api/script/AbstractScript.class)" -ForegroundColor Yellow
        $jar = Read-Host "Path"
        if (-not (Test-Path $jar)) {
            Write-Err "File not found. Exiting."
            exit 1
        }
    }
}

# Validate the jar
Write-Step "Validating $jar..."
$test = & jar tf $jar 2>$null | Select-String "AbstractScript"
if (-not $test) {
    Write-Err "The selected jar does NOT contain AbstractScript.class. It is not a DreamBot API jar."
    exit 1
}
Write-Ok "Valid DreamBot API jar: $jar"

# ---- 4. Compile ----
Write-Step "Compiling $SourceFile..."
$buildDir = Join-Path $PSScriptRoot "build"
if (Test-Path $buildDir) { Remove-Item $buildDir -Recurse -Force }
New-Item -ItemType Directory -Path $buildDir -Force | Out-Null

$compileArgs = @("-cp", $jar, "-d", $buildDir, "-source", "11", "-target", "11", $SourceFile)
Write-Info "javac $($compileArgs -join ' ')"
$compileOutput = & $javac $compileArgs 2>&1
if ($LASTEXITCODE -ne 0) {
    Write-Err "Compilation failed."
    $compileOutput | ForEach-Object { Write-Host $_ -ForegroundColor DarkYellow }
    exit 1
}
$classCount = (Get-ChildItem $buildDir -Recurse -Filter "*.class").Count
Write-Ok "Compiled $classCount class files."

# ---- 5. Package JAR ----
Write-Step "Creating JAR: $OutputJar"
$manifest = Join-Path $buildDir "MANIFEST.MF"
@"
Manifest-Version: 1.0
Main-Class: UltimateDiceBot
"@ | Set-Content $manifest -Encoding ASCII

$jarPath = Join-Path $PSScriptRoot $OutputJar
if (Test-Path $jarPath) { Remove-Item $jarPath -Force }
$jarTool = Join-Path (Split-Path $javac -Parent) "jar.exe"
if (-not (Test-Path $jarTool)) { $jarTool = "jar" }

$jarOutput = & $jarTool cfm $jarPath $manifest -C $buildDir . 2>&1
if ($LASTEXITCODE -ne 0) {
    Write-Err "JAR creation failed."
    $jarOutput | Write-Host -ForegroundColor Red
    exit 1
}
$jarSize = [math]::Round((Get-Item $jarPath).Length / 1KB, 1)
Write-Ok "JAR created: $jarPath ($jarSize KB)"

# ---- 6. Install ----
if (-not $SkipCopy) {
    Write-Step "Installing to DreamBot scripts folder..."
    $dest = "$env:USERPROFILE\.dreambot\scripts"
    if (-not (Test-Path $dest)) { New-Item -ItemType Directory -Path $dest -Force | Out-Null }
    Copy-Item $jarPath $dest -Force
    Write-Ok "Installed to $dest\$OutputJar"
} else {
    Write-Warn "-SkipCopy specified – not installed."
}

# ---- Summary ----
Write-Host "`n============================================================" -ForegroundColor Green
Write-Host "   BUILD SUCCESSFUL — UltimateDiceBot Pro v3.0" -ForegroundColor Green
Write-Host "============================================================" -ForegroundColor Green
Write-Host "  JAR : $jarPath"
Write-Host "  Classes : $classCount"
Write-Host "`nNext steps:" -ForegroundColor Cyan
Write-Host "  1. Open DreamBot"
Write-Host "  2. Go to Scripts → Local → Refresh"
Write-Host "  3. Select 'UltimateDiceBot Pro' and click Start"
Write-Host "  4. Configure settings in the GUI and click 'Start UltimateDiceBot Pro'"
Write-Host ""
