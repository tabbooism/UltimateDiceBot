    private int handleIdleBreak() {
        int ms = 3000 + random.nextInt(4000);
        updateStatus("Idle break for " + ms/1000 + " s...");
        sleep(ms);
        lastBreakTime = System.currentTimeMillis();
        currentState = BotState.WAITING_FOR_TRADE;
        return 200;
